# Cache dos arquivos estáticos (Cloudflare Workers Assets).
# O padrão da Cloudflare é "max-age=0, must-revalidate": o navegador pergunta ao servidor por TODA
# imagem a cada uso, e é isso que fazia escudos, bandeiras e cartas aparecerem aos pedaços.

# Arquivos gerados pelo build (nome com hash): nunca mudam.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes próprias: nunca mudam.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Arte do jogo: vale por um dia e, depois disso, o navegador usa a cópia e confere em segundo plano.
/cards/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
