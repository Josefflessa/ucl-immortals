{
  // Worker único: serve o frontend (dist/public, gerado pelo vite build), o
  // multiplayer (Durable Objects GameRoom/RoomDirectory) e as contas (D1).
  // "single-page-application" faz as rotas desconhecidas caírem no index.html.
  // Deploy: ver CLOUDFLARE_DEPLOY.md.
  "name": "ucl-immortals",
  "main": "server/cloudflare-worker.ts",
  "compatibility_date": "2026-07-01",
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "ROOM_DIRECTORY", "class_name": "RoomDirectory" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ucl-immortals-prod",
      "database_id": "50b59e7c-eb5c-4e76-bcaf-9b8abbe51b54"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom", "RoomDirectory"]
    }
  ],
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  }
}
